# Environment Configuration Example
# Copy this file to .env and fill in actual values before deployment

# Application
APP_NAME="Crowd Management System"
APP_VERSION="2.0.0"
DEBUG=False
ENVIRONMENT=production

# Server
HOST=0.0.0.0
PORT=8000
WORKERS=4

# Security
SECRET_KEY=change-this-to-a-secure-random-string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=30

# Database
DATABASE_URL=postgresql+psycopg2://user:password@localhost:5432/crowd_management

# Redis (for caching, queues, SSE)
REDIS_URL=redis://localhost:6379

# Gemma AI
GEMMA_API_KEY=your-gemma-api-key-here
GEMMA_PROVIDER=openrouter
GEMMA_MODEL=gemma-4
GEMMA_TIMEOUT_SECONDS=30
GEMMA_MAX_OUTPUT_TOKENS=1000

# CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:8080,https://your-domain.example

# Feature flags
AI_ASSISTANT_ENABLED=True
SSE_ENABLED=True
PUBLIC_QUEUE_ENABLED=True

# Order settings
MAX_ORDER_ITEMS=50
MAX_QUEUE_COUNT_CACHE_TTL=30